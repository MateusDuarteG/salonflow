# Gere uma chave longa e aleatória antes de publicar.
SECRET_KEY=troque-por-uma-chave-segura
# Desenvolvimento local usa SQLite automaticamente se DATABASE_URL ficar vazio.
# Produção: postgresql+psycopg://usuario:senha@host:5432/salonflow
DATABASE_URL=sqlite:///salonflow.db
COOKIE_SECURE=false
FLASK_DEBUG=true
PORT=5000
